# Variables visibles en el navegador. No colocar secretos en variables NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Variable exclusiva del servidor. Nunca exponerla al navegador ni versionar su valor real.
SUPABASE_SECRET_KEY=

# Nombre previsto para el bucket privado/público según la política que se implemente.
SUPABASE_NEWS_IMAGES_BUCKET=article-thumbnails

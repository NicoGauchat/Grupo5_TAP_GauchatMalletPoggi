# Configuración de Django (usar una clave secreta local y no versionar su valor real)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base PostgreSQL local aislada con Docker Compose
POSTGRES_DB=sitio_noticias
POSTGRES_USER=noticias_app
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Desarrollo local: prefer. Supabase: copiar los datos de Session pooler y usar require.
POSTGRES_SSLMODE=prefer

# Clave principal: clasificación y agrupamiento (no versionar el valor)
GEMINI_API_KEY=
# Segunda clave: importancia/resumen y respaldo de clasificación/agrupamiento ante 429 de la principal.
# Si falta la principal, la secundaria puede ejecutar todas las funciones.
GEMINI_API_KEY_SECONDARY=
# Modelo gratuito admitido: gemini-3.1-flash-lite o gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
# Respaldo opcional para resumen y agrupamiento; conservar la cuenta en el plan gratuito.
GROQ_API_KEY=

# Modo anterior, optativo en pruebas directas: Ollama primero.
AI_LOCAL_FIRST=false
# Actions activa API primero y Ollama de respaldo si responde el puente de la PC.
AI_API_FIRST=false
# Máximo de noticias/acontecimientos de respaldo local por comando (1 a 10).
OLLAMA_FALLBACK_LIMIT=10
# Modelo local descargado; no utiliza una clave API de Ollama.
OLLAMA_MODEL=qwen3:4b-instruct
# GitHub Actions: variable de repositorio OLLAMA_BRIDGE_URL y secreto OLLAMA_BRIDGE_TOKEN.
# Vacíos en desarrollo directo. El token no se versiona ni se imprime.
OLLAMA_BRIDGE_URL=
OLLAMA_BRIDGE_TOKEN=
